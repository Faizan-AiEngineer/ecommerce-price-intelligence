# Optional backend settings. Copy to backend/.env to override local defaults.
# Omit DATABASE_URL to use SQLite at backend/app.db.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/priceintel
API_V1_PREFIX=/api/v1
# Set a unique API_KEY before enabling API-key checks on the jobs and alerts routes.
# API_KEY=replace-with-a-unique-local-key
AUTH_REQUIRED=false
BASE_CURRENCY=USD
COLLECTION_INTERVAL_MINUTES=60
SCHEDULER_TIMEZONE=UTC

# Optional frontend override. Set this in frontend/.env for a separate API host.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
